{
  "name": "setup-soldr",
  "version": "0.1.0",
  "private": true,
  "description": "Setup-soldr GitHub Action: installs soldr, provisions Rust toolchain, manages caches. TypeScript port of the composite action.",
  "main": "dist/main.js",
  "scripts": {
    "pretest": "node --test --test-timeout=120000 --experimental-strip-types --import ./__tests__/register-loader.mjs __tests__/two-phase-actions-cache.test.ts",
    "build:main": "ncc build src/main.ts -o dist-main --license licenses.txt --no-source-map-register && node scripts/bundle-entrypoint.mjs main",
    "build:post": "ncc build src/post.ts -o dist-post --license licenses.txt --no-source-map-register && node scripts/bundle-entrypoint.mjs post",
    "build:cleanup": "ncc build src/cleanup.ts -o dist-cleanup --license licenses.txt --no-source-map-register && node scripts/bundle-entrypoint.mjs cleanup",
    "build:cook": "ncc build src/cook.ts -o dist-cook --license licenses.txt --no-source-map-register && node scripts/bundle-entrypoint.mjs cook",
    "build:cook-post": "ncc build src/cook-post.ts -o dist-cook-post --license licenses.txt --no-source-map-register && node scripts/bundle-entrypoint.mjs cook-post",
    "build": "npm run build:main && npm run build:post && npm run build:cleanup && npm run build:cook && npm run build:cook-post",
    "typecheck": "tsc --noEmit",
    "lint:vendor-prose": "node scripts/lint-vendor-prose.mjs",
    "test": "node --test --test-timeout=120000 --experimental-strip-types --import ./__tests__/register-loader.mjs __tests__/dylint-contract.test.ts __tests__/dylint-nightly.test.ts __tests__/prepare-dylint.test.ts __tests__/log-utils.test.ts __tests__/cache-keys.test.ts __tests__/ancestor-cache.test.ts __tests__/toolchain.test.ts __tests__/resolve-setup.test.ts __tests__/phase-timing.test.ts __tests__/normalize-source-mtime.test.ts __tests__/detect-shared-target-warning.test.ts __tests__/detect-musl-cc.test.ts __tests__/cache-compress.test.ts __tests__/run-pipe.test.ts __tests__/cache-encrypt.test.ts __tests__/zccache-seed.test.ts __tests__/verify-soldr.test.ts __tests__/ensure-rust-toolchain.test.ts __tests__/ensure-shims.test.ts __tests__/soldr-toolchain-client.test.ts __tests__/ensure-soldr.test.ts __tests__/release-readiness.test.ts __tests__/non-api-release.test.ts __tests__/main.test.ts __tests__/post.test.ts __tests__/compile-cache-stats.test.ts __tests__/dry-run.test.ts __tests__/install-passthrough.test.ts __tests__/shutdown-cache.test.ts __tests__/cleanup.test.ts __tests__/delete-run-scoped-caches.test.ts __tests__/cook-action.test.ts __tests__/cook-delta-default.test.ts __tests__/raw-inputs.test.ts __tests__/diagnostics.test.ts __tests__/source-mtime-snapshot.test.ts __tests__/compile-journal.test.ts __tests__/toolchain-snapshot.test.ts __tests__/solo-toolchain-cache.test.ts __tests__/cache-eviction.test.ts __tests__/cook-cache.test.ts __tests__/save-policy.test.ts __tests__/local-profile.test.ts __tests__/soldr-mini-cache.test.ts __tests__/seed-isolated-cache.test.ts __tests__/syslib-tool-cache.test.ts __tests__/tool-cache-store.test.ts __tests__/failed-job-save.test.ts __tests__/shim-bypass-check.test.ts __tests__/blessed-cross-prepare.test.ts __tests__/bench-paths.test.ts __tests__/bench-scripts.test.ts __tests__/soldr-load-shim.test.ts __tests__/watchdog-self-test.test.ts __tests__/yank-audit.test.ts __tests__/verdict-cache.test.ts"
  },
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/cache": "4.1.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1",
    "@iarna/toml": "^2.2.5",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.4",
    "has-flag": "4.0.0",
    "supports-color": "7.2.0",
    "typescript": "^5.7.0"
  }
}
