FROM rust:1.95.0-trixie

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       cmake \
       curl \
       libssl-dev \
       ninja-build \
       pkg-config \
       python3 \
       python3-venv \
       zstd \
    && rm -rf /var/lib/apt/lists/*

# Empty = the newest soldr on PyPI; pass --build-arg SOLDR_VERSION=X.Y.Z to pin.
ARG SOLDR_VERSION=
RUN python3 -m venv /opt/soldr \
    && /opt/soldr/bin/pip install --disable-pip-version-check "soldr${SOLDR_VERSION:+==${SOLDR_VERSION}}" \
    && /opt/soldr/bin/soldr --version

# The rust image ships CARGO_HOME=/usr/local/cargo. Relocate it onto the path
# the stack actually mounts a volume at, so the registry the seed downloads is
# the registry the warm container restores. Without this the seed archived a
# directory Cargo never wrote to (104 bytes, 0 entries) and the warm build
# would silently re-download every crate -- an offline rematerialization proof
# passing for the wrong reason. Toolchain binaries stay on PATH; RUSTUP_HOME
# is untouched.
# ZCCACHE_CACHE_DIR is pinned rather than left to soldr's default so the
# seed archives exactly the directory the warm run restores. Deriving it
# would be a guess, and a wrong guess archives an empty tree that still
# passes a `test -s` check -- the CARGO_HOME defect this file already fixed.
ENV ZCCACHE_CACHE_DIR=/root/.soldr/cache/zccache \
    CARGO_HOME=/root/.cargo \
    PATH="/opt/soldr/bin:${PATH}" \
    CARGO_BUILD_JOBS=1 \
    SOLDR_JOBS=1
# Serial builds. This host gives Docker 7.8 GiB shared with whatever else is
# running, and at 2 jobs the cc-rs compile of sqlite3.c was OOM-killed mid-seed
# -- soldr named the remedy itself (soldr#2453). A cache proof that dies under
# memory pressure is measuring the host, not the cache.
WORKDIR /workspace
